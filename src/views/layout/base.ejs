<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — TanaClean 2035' : 'TanaClean 2035' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/htmx.min.js" defer></script>
  <%- style %>
</head>
<body>
<div class="app-layout">

  <!-- ── Sidebar ───────────────────────────────────────────── -->
  <nav class="sidebar" id="sidebar">

    <div class="sidebar-header">
      <div class="sidebar-brand">
        <svg class="sidebar-brand-icon" width="34" height="22" viewBox="0 0 34 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Container body -->
          <rect x="0.5" y="1.5" width="17" height="11" rx="2" fill="white"/>
          <!-- Compactor door -->
          <rect x="13.5" y="1.5" width="4" height="11" rx="1" fill="white" fill-opacity="0.55"/>
          <!-- Cab -->
          <path d="M17.5 3 L17.5 12.5 L33.5 12.5 L33.5 9 L29 1.5 L17.5 1.5 Z" fill="white"/>
          <!-- Cab window -->
          <path d="M19 2.5 L27.5 2.5 L30.5 7.5 L19 7.5 Z" fill="#0F2922" fill-opacity="0.32"/>
          <!-- Wheels -->
          <circle cx="6" cy="16" r="4" fill="white"/>
          <circle cx="25.5" cy="16" r="4" fill="white"/>
          <circle cx="6" cy="16" r="1.8" fill="#0F2922" fill-opacity="0.28"/>
          <circle cx="25.5" cy="16" r="1.8" fill="#0F2922" fill-opacity="0.28"/>
        </svg>
        <span class="nav-label sidebar-brand-name">TanaClean 2035</span>
      </div>
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="Réduire la navigation">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
    </div>

    <div class="sidebar-section">
      <% if (user && user.role === 'admin') { %>
      <div class="sidebar-section-title"><span class="nav-label">Administration</span></div>
      <ul class="sidebar-nav">
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
          <a href="/admin" data-tooltip="Tableau de bord">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="nav-label">Tableau de bord</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'map' ? 'active' : '' %>">
          <a href="/admin/map" data-tooltip="Carte">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
            <span class="nav-label">Carte</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'planning' ? 'active' : '' %>">
          <a href="/admin/planning" data-tooltip="Planning">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="nav-label">Planning</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'complaints' ? 'active' : '' %>">
          <a href="/admin/complaints" data-tooltip="Réclamations">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span class="nav-label">Réclamations</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'workers' ? 'active' : '' %>">
          <a href="/admin/workers" data-tooltip="Éboueurs">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span class="nav-label">Éboueurs</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'trucks' ? 'active' : '' %>">
          <a href="/admin/trucks" data-tooltip="Camions">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span class="nav-label">Camions</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'historique' ? 'active' : '' %>">
          <a href="/admin/historique" data-tooltip="Historique">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="nav-label">Historique</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'active' : '' %>">
          <a href="/admin/settings" data-tooltip="Paramètres">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span class="nav-label">Paramètres</span>
          </a>
        </li>
      </ul>

      <% } else if (user && user.role === 'worker') { %>
      <div class="sidebar-section-title"><span class="nav-label">Éboueur</span></div>
      <ul class="sidebar-nav">
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
          <a href="/worker" data-tooltip="Tableau de bord">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="nav-label">Tableau de bord</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'schedule' ? 'active' : '' %>">
          <a href="/worker/schedule" data-tooltip="Mon planning">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="nav-label">Mon planning</span>
          </a>
        </li>
      </ul>

      <% } else if (user && user.role === 'citizen') { %>
      <div class="sidebar-section-title"><span class="nav-label">Citoyen</span></div>
      <ul class="sidebar-nav">
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
          <a href="/citizen" data-tooltip="Tableau de bord">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="nav-label">Tableau de bord</span>
          </a>
        </li>
        <li class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'complaints' ? 'active' : '' %>">
          <a href="/citizen/complaints" data-tooltip="Réclamations">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span class="nav-label">Réclamations</span>
          </a>
        </li>
      </ul>
      <% } %>
    </div>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.7)" stroke-width="1.5" style="flex-shrink:0;border-radius:50%"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        <div class="sidebar-user-info nav-label">
          <div class="sidebar-user-name"><%= user ? user.name : '' %></div>
          <div class="sidebar-user-role"><%= user ? user.role : '' %></div>
        </div>
      </div>
      <form action="/logout" method="POST" class="nav-label" style="margin-top:var(--sp-3)"
            onsubmit="return confirm('Voulez-vous vraiment vous déconnecter ?')">
        <button type="submit" class="btn btn-link" style="color:rgba(255,255,255,0.45);font-size:var(--text-sm)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Déconnexion
        </button>
      </form>
    </div>
  </nav>

  <!-- ── Overlay mobile ──────────────────────────────────────── -->
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeMobileSidebar()"></div>

  <!-- ── Contenu principal ─────────────────────────────────── -->
  <div class="main-content">
    <div class="topbar">
      <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleMobileSidebar()" aria-label="Menu" style="display:none">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1 class="topbar-title"><%= typeof title !== 'undefined' ? title : 'TanaClean 2035' %></h1>
      <div class="topbar-actions">
        <%- typeof topbarActions !== 'undefined' ? topbarActions : '' %>

        <!-- ── Cloche de notification ── -->
        <div class="notif-wrapper" id="notifWrapper">
          <button class="notif-btn" id="notifBtn" onclick="toggleNotifPanel()" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span id="notif-badge"
                  hx-get="/notif/count"
                  hx-trigger="load, every 30s"
                  hx-swap="outerHTML"
                  class="notif-badge"></span>
          </button>
          <div class="notif-panel" id="notifPanel"
               hx-get="/notif/list"
               hx-trigger="revealed"
               hx-swap="innerHTML"></div>
        </div>

      </div>
    </div>

    <div class="page-content">
      <%- body %>
    </div>
  </div>

</div>

<!-- ── FAB mobile (ajout) ──────────────────────────────────── -->
<div class="fab-overlay" id="fabOverlay" onclick="closeFabPanel()"></div>
<button class="fab-btn" id="fabBtn" onclick="toggleFabPanel()" aria-label="Ajouter" style="display:none">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
</button>

<!-- ── Drawer ──────────────────────────────────────────────── -->
<div id="drawer-overlay" class="drawer-overlay" onclick="closeDrawer()"></div>
<div id="drawer" class="drawer" role="dialog" aria-modal="true">
  <div id="drawer-content"></div>
</div>

<%- script %>
<script>
  /* ── Sidebar desktop (collapse) + mobile (overlay) ── */
  (function () {
    const sidebar  = document.getElementById('sidebar');
    const toggle   = document.getElementById('sidebarToggle');
    const hamburger = document.getElementById('hamburgerBtn');
    if (!sidebar) return;

    const KEY    = 'tc-sidebar-collapsed';
    const MOBILE = window.matchMedia('(max-width: 768px)');

    function applyMode() {
      if (MOBILE.matches) {
        hamburger.style.display = 'flex';
        toggle.style.display    = 'none';
      } else {
        hamburger.style.display = 'none';
        toggle.style.display    = 'flex';
        sidebar.classList.remove('mobile-open');
        document.getElementById('sidebarOverlay').classList.remove('open');
        document.body.style.overflow = '';
        if (localStorage.getItem(KEY) === 'true') sidebar.classList.add('collapsed');
      }
    }

    if (localStorage.getItem(KEY) === 'true') sidebar.classList.add('collapsed');
    applyMode();
    MOBILE.addEventListener('change', applyMode);

    if (toggle) {
      toggle.addEventListener('click', function () {
        sidebar.classList.toggle('collapsed');
        localStorage.setItem(KEY, sidebar.classList.contains('collapsed'));
      });
    }
  })();

  function toggleMobileSidebar() {
    const sidebar  = document.getElementById('sidebar');
    const overlay  = document.getElementById('sidebarOverlay');
    const isOpen   = sidebar.classList.toggle('mobile-open');
    overlay.classList.toggle('open', isOpen);
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  function closeMobileSidebar() {
    document.getElementById('sidebar').classList.remove('mobile-open');
    document.getElementById('sidebarOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  /* ── FAB mobile ── */
  (function () {
    var MOBILE = window.matchMedia('(max-width: 768px)');
    var fab    = document.getElementById('fabBtn');
    var panel  = document.getElementById('addFabPanel');
    var overlay = document.getElementById('fabOverlay');
    if (!panel) return; // pas de panel d'ajout sur cette page

    function applyFab() {
      if (MOBILE.matches) {
        fab.style.display = 'flex';
      } else {
        fab.style.display = 'none';
        panel.classList.remove('fab-open');
        overlay.classList.remove('open');
      }
    }
    applyFab();
    MOBILE.addEventListener('change', applyFab);
  })();

  function toggleFabPanel() {
    var panel   = document.getElementById('addFabPanel');
    var overlay = document.getElementById('fabOverlay');
    var fab     = document.getElementById('fabBtn');
    if (!panel) return;
    var open = panel.classList.toggle('fab-open');
    overlay.classList.toggle('open', open);
    fab.classList.toggle('fab-active', open);
  }

  function closeFabPanel() {
    var panel   = document.getElementById('addFabPanel');
    var overlay = document.getElementById('fabOverlay');
    var fab     = document.getElementById('fabBtn');
    if (!panel) return;
    panel.classList.remove('fab-open');
    overlay.classList.remove('open');
    fab.classList.remove('fab-active');
  }

  /* ── Auto data-label sur les tableaux (responsive cards) ── */
  function labelTables() {
    document.querySelectorAll('.aui-table').forEach(function(table) {
      var headers = Array.from(table.querySelectorAll('thead th')).map(function(th) {
        return th.textContent.trim();
      });
      if (!headers.length) return;
      table.querySelectorAll('tbody tr').forEach(function(row) {
        Array.from(row.querySelectorAll('td')).forEach(function(td, i) {
          td.setAttribute('data-label', headers[i] || '');
        });
      });
    });
  }
  labelTables();
  /* Re-labelliser après chaque swap HTMX (tableau rechargé dynamiquement) */
  document.body.addEventListener('htmx:afterSettle', labelTables);

  /* ── Drawer ── */
  function openDrawer() {
    document.getElementById('drawer').classList.add('open');
    document.getElementById('drawer-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    document.getElementById('drawer').classList.remove('open');
    document.getElementById('drawer-overlay').classList.remove('open');
    document.body.style.overflow = '';
    setTimeout(function () {
      document.getElementById('drawer-content').innerHTML = '';
    }, 280);
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeDrawer();
  });

  document.body.addEventListener('htmx:afterSwap', function (e) {
    if (e.detail.target.id === 'drawer-content') openDrawer();
  });

  /* ── Notification panel ── */
  function toggleNotifPanel() {
    const panel = document.getElementById('notifPanel');
    const btn   = document.getElementById('notifBtn');
    const open  = panel.classList.toggle('open');
    btn.classList.toggle('active', open);
    if (open) htmx.trigger(panel, 'revealed');
  }

  function closeNotifPanel() {
    document.getElementById('notifPanel').classList.remove('open');
    document.getElementById('notifBtn').classList.remove('active');
  }

  document.addEventListener('click', function (e) {
    const wrapper = document.getElementById('notifWrapper');
    if (wrapper && !wrapper.contains(e.target)) closeNotifPanel();
  });
</script>
</body>
</html>

<% if (success) { %>
<div class="alert alert-success mb-4">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
  Votre réclamation a été envoyée avec succès.
</div>
<% } %>

<div class="page-2col">

  <!-- Historique -->
  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">Mes réclamations</h2>
    </div>
    <div style="padding:0">
      <% if (complaints.length === 0) { %>
      <p style="text-align:center;color:var(--color-text-subtle);padding:var(--sp-5)">Aucune réclamation déposée.</p>
      <% } %>

      <% complaints.forEach(c => { %>
      <%
        const cl = { open:'lozenge-danger', processing:'lozenge-warning', closed:'lozenge-success' };
        const ct = { open:'Ouverte', processing:'En cours', closed:'Clôturée' };
        const cResponses = responses.get(c.id) || [];
      %>
      <div class="complaint-card">
        <!-- En-tête -->
        <div class="complaint-card-header">
          <div style="flex:1;min-width:0">
            <div style="display:flex;align-items:center;gap:var(--sp-2);flex-wrap:wrap;margin-bottom:var(--sp-1)">
              <span class="lozenge <%= cl[c.status] %>"><%= ct[c.status] %></span>
              <% if (c.is_urgent) { %><span class="lozenge lozenge-urgent">Urgent</span><% } %>
              <span class="text-sm text-subtle"><%= c.district_name %> · <%= c.created_at.slice(0,10) %></span>
            </div>
            <p class="complaint-card-content"><%= c.content %></p>
          </div>
          <% if (cResponses.length > 0) { %>
          <span class="lozenge lozenge-default" style="flex-shrink:0"><%= cResponses.length %> réponse<%= cResponses.length > 1 ? 's' : '' %></span>
          <% } %>
        </div>

        <!-- Réponses -->
        <% if (cResponses.length > 0) { %>
        <div class="complaint-responses">
          <p class="complaint-responses-label">Réponses de l'administration</p>
          <% cResponses.forEach(r => { %>
          <div class="complaint-response-item">
            <div class="complaint-response-meta">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <%= r.author_name %>
              <span>·</span>
              <%= new Date(r.created_at).toLocaleDateString('fr-FR', {day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'}) %>
            </div>
            <p class="complaint-response-body"><%= r.content %></p>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
      <% }) %>

      <%- include('../partials/pagination', { currentPage, totalPages, total, baseParams }) %>
    </div>
  </div>

  <!-- Nouveau dépôt -->
  <div class="panel add-fab-panel" id="addFabPanel" data-fab-label="Déposer une réclamation">
    <div class="panel-header">
      <h2 class="panel-title">Déposer une réclamation</h2>
    </div>
    <div class="panel-body">
      <form action="/citizen/complaints" method="POST">
        <div class="form-group">
          <label class="form-label">Quartier concerné</label>
          <select name="district_id" class="form-select" required>
            <option value="">Sélectionner…</option>
            <% districts.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Description du problème</label>
          <textarea name="content" class="form-textarea" rows="4"
            placeholder="Décrivez le problème rencontré…" required></textarea>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:var(--sp-2);cursor:pointer">
            <input type="checkbox" name="is_urgent" value="1" style="width:16px;height:16px">
            <span class="form-label" style="margin:0">Signalement urgent</span>
          </label>
          <p class="form-hint">Cocher uniquement si la situation représente un danger immédiat.</p>
        </div>
        <button type="submit" class="btn btn-primary w-full" style="justify-content:center">
          Envoyer la réclamation
        </button>
      </form>
    </div>
  </div>

</div>

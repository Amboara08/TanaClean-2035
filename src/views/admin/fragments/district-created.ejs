<%# Données du nouveau quartier lues par le JS Leaflet %>
<div id="new-district-data"
     data-id="<%= district.id %>"
     data-name="<%= district.name %>"
     data-priority="<%= district.priority %>"
     data-lat="<%= district.lat ?? '' %>"
     data-lng="<%= district.lng ?? '' %>"
     style="display:none"></div>

<div style="padding:var(--sp-3);background:#EFF8F5;border-left:3px solid #0B7A68;
            border-radius:var(--radius-md);font-size:var(--text-sm);color:#0B7A68;
            display:flex;align-items:center;gap:var(--sp-3)">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
  <div>
    <strong><%= district.name %></strong> ajouté
    <% if (district.lat && district.lng) { %>
      · placé sur la carte
    <% } else { %>
      · sans coordonnées GPS
    <% } %>
  </div>
</div>

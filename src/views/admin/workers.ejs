<%- include('../partials/auto-open-drawer', { autoOpen, drawerUrl: '/admin/workers' }) %>

<div class="page-2col-sm">

  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">Équipe d'éboueurs</h2>
      <span class="lozenge lozenge-info"><%= workers.length %> membres</span>
    </div>
    <div class="table-scroll" style="padding:0">
      <table class="aui-table">
        <thead>
          <tr><th>Nom</th><th>Email</th><th>Quartier de base</th><th>Depuis</th></tr>
        </thead>
        <tbody>
          <% workers.forEach(w => { %>
          <tr hx-get="/admin/workers/<%= w.id %>" hx-target="#drawer-content" hx-swap="innerHTML">
            <td><strong><%= w.name %></strong></td>
            <td class="text-subtle text-sm"><%= w.email %></td>
            <td><%= w.district_name || '—' %></td>
            <td class="text-subtle text-sm"><%= w.created_at.slice(0,10) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <%- include('../partials/pagination', { currentPage, totalPages, total, baseParams }) %>
    </div>
  </div>

  <div class="panel add-fab-panel" id="addFabPanel" data-fab-label="Ajouter un éboueur">
    <div class="panel-header">
      <h2 class="panel-title">Ajouter un éboueur</h2>
    </div>
    <div class="panel-body">
      <form action="/admin/workers" method="POST">
        <div class="form-group">
          <label class="form-label">Nom complet</label>
          <input type="text" name="name" class="form-input" placeholder="Prénom Nom" required>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-input" placeholder="nom@tanaclean.mg" required>
        </div>
        <div class="form-group">
          <label class="form-label">Quartier de base</label>
          <select name="district_id" class="form-select">
            <option value="">Aucun</option>
            <% districts.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Mot de passe</label>
          <input type="password" name="password" class="form-input" placeholder="Min. 6 caractères" minlength="6" required>
          <p class="form-hint">L'éboueur utilisera ce mot de passe pour se connecter.</p>
        </div>
        <button type="submit" class="btn btn-primary w-full" style="justify-content:center;margin-top:var(--sp-3)">
          Ajouter
        </button>
      </form>
    </div>
  </div>

</div>

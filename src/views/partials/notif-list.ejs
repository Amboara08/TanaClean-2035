<%
  const roleLink = role === 'admin' ? '/admin' : (role === 'citizen' ? '/citizen' : '/worker');
%>
<div class="notif-panel-header">
  <span class="notif-panel-title">Notifications</span>
  <% if (items.some(i => !i.is_read)) { %>
  <button class="btn btn-link btn-sm"
          hx-post="/notif/mark-read"
          hx-trigger="click"
          hx-swap="none"
          onclick="document.getElementById('notif-badge').className='notif-badge'">
    Tout marquer lu
  </button>
  <% } %>
</div>

<% if (!items.length) { %>
<div class="notif-empty">
  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-border)" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
  <p>Aucune notification</p>
</div>
<% } else { %>
<ul class="notif-item-list">
  <% items.forEach(function(item) { %>
  <a href="<%= item.link %>" class="notif-item<%= !item.is_read ? ' notif-item-unread' : '' %>" onclick="closeNotifPanel()">
    <div class="notif-item-icon<%= item.urgent ? ' notif-item-icon-urgent' : '' %>">
      <% if (item.urgent) { %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <% } else { %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <% } %>
    </div>
    <div class="notif-item-body">
      <p class="notif-item-text"><%= item.body %></p>
      <span class="notif-item-meta"><%= new Date(item.date).toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) %></span>
    </div>
  </a>
  <% }) %>
</ul>
<% } %>

<div class="notif-panel-footer">
  <a href="<%= roleLink %>" class="btn btn-link btn-sm" onclick="closeNotifPanel()">
    Voir tout →
  </a>
</div>

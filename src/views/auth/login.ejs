<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isElectron ? 'Administration — TanaClean 2035' : 'Connexion — TanaClean 2035' %></title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    /* ── Bandeau desktop ────────────────────────────────────────────── */
    .desktop-banner {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      background: var(--color-brand);
      color: #fff;
      padding: var(--sp-3) var(--sp-4);
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      margin: 0 0 var(--sp-5);
      font-size: var(--text-sm);
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .desktop-banner svg { flex-shrink: 0; }
    .desktop-banner-sub {
      font-size: var(--text-xs);
      font-weight: 400;
      opacity: 0.8;
      display: block;
      margin-top: 1px;
    }

    /* ── Alerte blocage (non-admin tenté de se connecter) ───────────── */
    .alert-desktop-block {
      background: var(--color-warning-bg);
      border: 1px solid var(--color-warning);
      border-left: 4px solid var(--color-warning);
      border-radius: var(--radius-sm);
      padding: var(--sp-4);
      margin-bottom: var(--sp-5);
    }
    .alert-desktop-block .block-title {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      font-weight: 700;
      font-size: var(--text-base);
      color: var(--color-warning);
      margin-bottom: var(--sp-2);
    }
    .alert-desktop-block p {
      font-size: var(--text-sm);
      color: var(--color-text);
      margin: 0 0 var(--sp-1);
      line-height: 1.5;
    }
    .alert-desktop-block .role-tag {
      display: inline-block;
      background: var(--color-warning-bg);
      border: 1px solid var(--color-warning);
      border-radius: 2px;
      padding: 1px 6px;
      font-size: var(--text-xs);
      font-weight: 700;
      color: var(--color-warning);
      text-transform: uppercase;
    }
  </style>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">

    <%# ── Bandeau "version desktop" uniquement dans Electron ─────────── %>
    <% if (isElectron) { %>
    <div class="desktop-banner">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2"/>
        <line x1="8" y1="21" x2="16" y2="21"/>
        <line x1="12" y1="17" x2="12" y2="21"/>
      </svg>
      <!-- <div>
        Version Desktop
        <span class="desktop-banner-sub">Réservée aux administrateurs du système</span>
      </div> -->
    </div>
    <% } %>

    <%# ── Logo ──────────────────────────────────────────────────────── %>
    <div class="auth-logo">
      <svg width="80" height="52" viewBox="0 0 34 22" fill="none" xmlns="http://www.w3.org/2000/svg"
           style="display:block;margin:0 auto 14px">
        <rect x="0.5" y="1.5" width="17" height="11" rx="2" fill="var(--color-brand)"/>
        <rect x="13.5" y="1.5" width="4" height="11" rx="1" fill="var(--color-brand-hover)" fill-opacity="0.7"/>
        <path d="M17.5 3 L17.5 12.5 L33.5 12.5 L33.5 9 L29 1.5 L17.5 1.5 Z" fill="var(--color-brand)"/>
        <path d="M19 2.5 L27.5 2.5 L30.5 7.5 L19 7.5 Z" fill="white" fill-opacity="0.35"/>
        <circle cx="6"    cy="16" r="4"   fill="#07201A"/>
        <circle cx="25.5" cy="16" r="4"   fill="#07201A"/>
        <circle cx="6"    cy="16" r="1.8" fill="white" fill-opacity="0.3"/>
        <circle cx="25.5" cy="16" r="1.8" fill="white" fill-opacity="0.3"/>
      </svg>
      <div class="auth-logo-text">TanaClean 2035</div>
      <div class="auth-logo-sub">
        <% if (isElectron) { %>
          Interface d'administration
        <% } else { %>
          Optimisation de la collecte des déchets
        <% } %>
      </div>
    </div>

    <h2 class="auth-title">
      <% if (isElectron) { %>
        Connexion Administrateur
      <% } else { %>
        Connexion
      <% } %>
    </h2>

    <%# ── Alerte si un non-admin a tenté de se connecter ────────────── %>
    <% if (typeof desktopBlocked !== 'undefined' && desktopBlocked) { %>
    <div class="alert-desktop-block">
      <div class="block-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Accès refusé — version desktop
      </div>
      <p>
        Bonjour <strong><%= blockedName %></strong>, votre compte
        <span class="role-tag"><%= blockedRole %></span>
        n'a pas accès à l'application desktop.
      </p>
      <p style="color:var(--color-text-subtle)">
        Connectez-vous depuis votre navigateur web :
        <strong style="font-family:var(--font-mono)">http://localhost:3131</strong>
      </p>
    </div>
    <% } %>

    <%# ── Alerte succès inscription ──────────────────────────────────── %>
    <% if (registered) { %>
    <div class="alert alert-success" style="margin-bottom:var(--sp-4)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
      Compte créé avec succès ! Vous pouvez maintenant vous connecter.
    </div>
    <% } %>

    <%# ── Alerte erreur ───────────────────────────────────────────────── %>
    <% if (error) { %>
    <div class="alert alert-error" style="margin-bottom:var(--sp-4)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" style="flex-shrink:0;margin-top:2px">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8"  x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <%= error %>
    </div>
    <% } %>

    <%# ── Formulaire ──────────────────────────────────────────────────── %>
    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">Adresse e-mail</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          placeholder="<%= isElectron ? 'admin@tanaclean.mg' : 'vous@exemple.com' %>"
          autocomplete="email"
          required
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Mot de passe</label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-input"
          placeholder="••••••••"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="btn btn-primary w-full" style="justify-content:center;padding:10px">
        <% if (isElectron) { %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               style="margin-right:6px">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Accéder à l'administration
        <% } else { %>
          Se connecter
        <% } %>
      </button>
    </form>

    <%# ── Liens du bas (masqués en mode desktop) ─────────────────────── %>
    <% if (!isElectron) { %>
    <p style="margin-top:var(--sp-5);text-align:center;font-size:var(--text-sm);color:var(--color-text-subtle)">
      Pas encore de compte ?
      <a href="/register" style="color:var(--color-brand);text-decoration:none;font-weight:600">S'inscrire</a>
    </p>
    <!-- <p style="margin-top:var(--sp-4);text-align:center;font-size:var(--text-sm);color:var(--color-text-subtle)">
      Comptes de test :<br>
      <code style="font-family:var(--font-mono)">admin@tanaclean.mg</code> /
      <code style="font-family:var(--font-mono)">jean@tanaclean.mg</code> /
      <code style="font-family:var(--font-mono)">voahary@mail.mg</code>
    </p> -->
    <% } else { %>
    <p style="margin-top:var(--sp-5);text-align:center;font-size:var(--text-xs);color:var(--color-text-subtle)">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" style="vertical-align:middle;margin-right:3px">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      Accès réservé aux administrateurs
    </p>
    <% } %>

  </div>
</div>
</body>
</html>

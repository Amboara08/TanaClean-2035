<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interface desktop requise — TanaClean 2035</title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    /* ── Layout ───────────────────────────────────────────────────────── */
    .restricted-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #07201A 0%, #0B7A68 55%, #0D9E87 100%);
      padding: var(--sp-4);
    }

    .restricted-card {
      width: 100%;
      max-width: 420px;
      background: rgba(255,255,255,0.97);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-modal);
      overflow: hidden;
    }

    /* ── Barre de statut en haut ──────────────────────────────────────── */
    .restricted-topbar {
      height: 4px;
      background: linear-gradient(90deg, var(--color-brand) 0%, var(--color-brand-hover) 100%);
    }

    /* ── Corps de la card ─────────────────────────────────────────────── */
    .restricted-body {
      padding: var(--sp-10) var(--sp-8) var(--sp-8);
    }

    /* ── Logo ─────────────────────────────────────────────────────────── */
    .restricted-logo {
      text-align: center;
      margin-bottom: var(--sp-8);
    }
    .restricted-logo-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      background: var(--color-brand-subtle);
      border-radius: var(--radius-lg);
      margin-bottom: var(--sp-3);
    }
    .restricted-logo-name {
      font-size: var(--text-xl);
      font-weight: 700;
      color: var(--color-brand);
      letter-spacing: -0.02em;
    }
    .restricted-logo-sub {
      font-size: var(--text-sm);
      color: var(--color-text-subtle);
      margin-top: var(--sp-1);
    }

    /* ── Titre + badge ────────────────────────────────────────────────── */
    .restricted-header {
      text-align: center;
      margin-bottom: var(--sp-6);
      padding-bottom: var(--sp-6);
      border-bottom: 1px solid var(--color-border-light);
    }
    .restricted-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: var(--color-warning-bg);
      color: var(--color-warning);
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      margin-bottom: var(--sp-3);
    }
    .restricted-title {
      font-size: var(--text-md);
      font-weight: 600;
      color: var(--color-text);
      letter-spacing: -0.01em;
      margin-bottom: var(--sp-2);
    }
    .restricted-desc {
      font-size: var(--text-sm);
      color: var(--color-text-subtle);
      line-height: var(--leading-normal);
    }

    /* ── Steps ────────────────────────────────────────────────────────── */
    .step-list {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--sp-6);
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
    }
    .step-item {
      display: flex;
      align-items: flex-start;
      gap: var(--sp-3);
      padding: var(--sp-3) var(--sp-4);
      background: var(--color-bg);
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border-light);
    }
    .step-num {
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      background: var(--color-brand);
      color: #fff;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 700;
      margin-top: 1px;
    }
    .step-text {
      font-size: var(--text-sm);
      color: var(--color-text);
      line-height: var(--leading-normal);
    }
    .step-text strong {
      color: var(--color-brand-bold);
    }

    /* ── Séparateur ───────────────────────────────────────────────────── */
    .or-divider {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      margin-bottom: var(--sp-5);
      font-size: var(--text-xs);
      color: var(--color-text-subtle);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 500;
    }
    .or-divider::before,
    .or-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--color-border-light);
    }

    /* ── Boutons ──────────────────────────────────────────────────────── */
    .restricted-actions {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
    }
    .btn-citizen {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--sp-2);
      width: 100%;
      padding: 10px var(--sp-4);
      background: var(--color-brand);
      color: #fff;
      border: none;
      border-radius: var(--radius-md);
      font-size: var(--text-base);
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background var(--transition-fast);
      font-family: var(--font-body);
    }
    .btn-citizen:hover {
      background: var(--color-brand-hover);
    }
  </style>
</head>
<body>
<div class="restricted-page">
  <div class="restricted-card">

    <%# Barre de couleur en haut %>
    <div class="restricted-topbar"></div>

    <div class="restricted-body">

      <%# Logo %>
      <div class="restricted-logo">
        <div class="restricted-logo-icon">
          <%# SVG camion (même que login) %>
          <svg width="30" height="20" viewBox="0 0 34 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="0.5" y="1.5" width="17" height="11" rx="2" fill="var(--color-brand)"/>
            <rect x="13.5" y="1.5" width="4" height="11" rx="1" fill="var(--color-brand-hover)" fill-opacity="0.8"/>
            <path d="M17.5 3 L17.5 12.5 L33.5 12.5 L33.5 9 L29 1.5 L17.5 1.5 Z" fill="var(--color-brand)"/>
            <path d="M19 2.5 L27.5 2.5 L30.5 7.5 L19 7.5 Z" fill="white" fill-opacity="0.4"/>
            <circle cx="6"    cy="16" r="4"   fill="#07201A"/>
            <circle cx="25.5" cy="16" r="4"   fill="#07201A"/>
            <circle cx="6"    cy="16" r="1.8" fill="white" fill-opacity="0.25"/>
            <circle cx="25.5" cy="16" r="1.8" fill="white" fill-opacity="0.25"/>
          </svg>
        </div>
        <div class="restricted-logo-name">TanaClean 2035</div>
        <div class="restricted-logo-sub">Optimisation de la collecte des déchets</div>
      </div>

      <%# Titre %>
      <div class="restricted-header">
        <div class="restricted-badge">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="3">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Accès restreint
        </div>
        <h1 class="restricted-title">Interface admin — application desktop</h1>
        <p class="restricted-desc">
          L'interface administrateur est accessible uniquement depuis
          l'application desktop TanaClean 2035, pas depuis un navigateur web.
        </p>
      </div>

      <%# Étapes %>
      <ul class="step-list">
        <li class="step-item">
          <span class="step-num">1</span>
          <span class="step-text">
            Ouvrez l'application <strong>TanaClean 2035</strong>
            installée sur votre machine
          </span>
        </li>
        <li class="step-item">
          <span class="step-num">2</span>
          <span class="step-text">
            Connectez-vous avec votre compte <strong>administrateur</strong>
          </span>
        </li>
        <li class="step-item">
          <span class="step-num">3</span>
          <span class="step-text">
            Vous accéderez au tableau de bord complet
          </span>
        </li>
      </ul>

      <%# Séparateur %>
      <div class="or-divider">Vous n'êtes pas admin ?</div>

      <%# CTA %>
      <div class="restricted-actions">
        <a href="/login" class="btn-citizen">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Connexion éboueur / citoyen
        </a>
      </div>

    </div>
  </div>
</div>
</body>
</html>

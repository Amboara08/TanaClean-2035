{
  "name": "tanaclean-2035",
  "version": "1.0.0",
  "description": "Système intelligent d'optimisation de la collecte des déchets à Antananarivo",
  "main": "electron/main.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node database/seed.js",
    "electron": "electron .",
    "test": "jest tests/",
    "build": "electron-builder"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.0",
    "express-session": "^1.18.0",
    "mysql2": "^3.9.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "mg.tanaclean.app",
    "productName": "TanaClean 2035",
    "copyright": "© 2026 ANDRIAMAMONJISOA Amboara",
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "src/**/*",
      "database/schema.sql",
      "database/seed.js",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon.png", "to": "icon.png" }
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TanaClean 2035",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  },
  "author": "ANDRIAMAMONJISOA Amboara",
  "license": "ISC"
}
